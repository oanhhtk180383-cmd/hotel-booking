@model BookingModel
@{ViewData["Title"]="Xác nhận đặt phòng";LoaiPhong type=ViewBag.Type;var nights=(Model.NgayTra.Date-Model.NgayNhan.Date).Days;}
<section class="surface booking-summary"><span class="eyebrow">XÁC NHẬN LƯU TRÚ</span><h1>Xác nhận đặt phòng</h1><h2 class="h4">@type.TenLoaiPhong</h2><dl class="row my-4"><dt class="col-5">Nhận phòng</dt><dd class="col-7">@Model.NgayNhan.ToString("dd/MM/yyyy")</dd><dt class="col-5">Trả phòng</dt><dd class="col-7">@Model.NgayTra.ToString("dd/MM/yyyy")</dd><dt class="col-5">Lưu trú</dt><dd class="col-7">@nights đêm · @Model.SoKhach khách</dd><dt class="col-5">Giá mỗi đêm</dt><dd class="col-7">@type.GiaMoiDem.ToString("N0") ₫</dd><dt class="col-5">Tổng tiền dự kiến</dt><dd class="col-7 fw-bold">@((nights*type.GiaMoiDem).ToString("N0")) ₫</dd></dl><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="MaLoaiPhong" type="hidden"/><input asp-for="NgayNhan" type="hidden"/><input asp-for="NgayTra" type="hidden"/><input asp-for="SoKhach" type="hidden"/><label asp-for="PhuongThucThanhToan" class="form-label">Phương thức thanh toán</label><select asp-for="PhuongThucThanhToan" class="form-select mb-3"><option value="TaiKhachSan">Tại khách sạn</option><option value="ChuyenKhoan">Chuyển khoản</option></select><span asp-validation-for="PhuongThucThanhToan" class="text-danger d-block mb-3"></span><label asp-for="GhiChu" class="form-label">Ghi chú</label><textarea asp-for="GhiChu" class="form-control mb-3" rows="3" maxlength="500"></textarea><span asp-validation-for="GhiChu" class="text-danger"></span><p class="text-muted small">Phòng trống và giá sẽ được kiểm tra lại khi xác nhận.</p><button class="btn btn-primary w-100">Xác nhận đặt phòng</button></form></section>

