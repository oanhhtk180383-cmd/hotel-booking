@model PagedList<DatPhong>
@{ViewData["Title"]="Đặt phòng của tôi";}
<span class="eyebrow">LỊCH SỬ LƯU TRÚ</span><h1>Đặt phòng của tôi</h1><p class="text-muted">Theo dõi trạng thái và quản lý các đặt phòng của bạn.</p>
@if(Model.Count==0){<div class="empty-state">Bạn chưa có đặt phòng. <a asp-controller="Rooms" asp-action="Index">Xem phòng</a></div>}
@foreach(var d in Model){<article class="surface my-3"><div class="d-flex justify-content-between flex-wrap gap-2"><div><span class="eyebrow">MÃ ĐẶT PHÒNG #@d.MaDatPhong</span><h2 class="h4 mt-2">@d.Phong.LoaiPhong!.TenLoaiPhong · Phòng @d.Phong.SoPhong</h2></div><span class="status @d.TrangThai">@Labels.Status(d.TrangThai)</span></div><p class="text-muted">@d.NgayNhan.ToString("dd/MM/yyyy") → @d.NgayTra.ToString("dd/MM/yyyy") · @d.SoKhach khách</p><div class="d-flex align-items-center gap-3 flex-wrap"><strong class="me-auto">@d.TongTien.ToString("N0") ₫</strong><a class="btn btn-outline-primary btn-sm" asp-action="Details" asp-route-id="@d.MaDatPhong">Chi tiết</a>@if((d.TrangThai=="ChoXacNhan" || d.TrangThai=="DaXacNhan") && d.NgayNhan>=HotelClock.Today.AddDays(1)){<form asp-action="Cancel" asp-route-id="@d.MaDatPhong" method="post" data-confirm="Hủy đặt phòng này?"><button class="btn btn-outline-danger btn-sm">Hủy đặt phòng</button></form>}@if(d.TrangThai=="HoanThanh" && d.DanhGia is null){<a class="btn btn-primary btn-sm" asp-controller="Review" asp-action="Create" asp-route-id="@d.MaDatPhong">Đánh giá</a>}@if(d.DanhGia is not null){<span class="stars">Đã đánh giá @d.DanhGia.SoSao ★</span>}</div></article>}

<partial name="_Pagination" model="Model"/>
