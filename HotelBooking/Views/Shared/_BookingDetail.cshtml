@model DatPhong
<div class="surface booking-summary"><span class="eyebrow">MÃ ĐẶT PHÒNG #@Model.MaDatPhong</span><h2 class="h3 mt-3">@Model.Phong.LoaiPhong!.TenLoaiPhong</h2><span class="status @Model.TrangThai">@Labels.Status(Model.TrangThai)</span><dl class="row mt-4"><dt class="col-5">Số phòng</dt><dd class="col-7">@Model.Phong.SoPhong</dd><dt class="col-5">Ngày nhận</dt><dd class="col-7">@Model.NgayNhan.ToString("dd/MM/yyyy")</dd><dt class="col-5">Ngày trả</dt><dd class="col-7">@Model.NgayTra.ToString("dd/MM/yyyy")</dd><dt class="col-5">Số đêm / khách</dt><dd class="col-7">@((Model.NgayTra-Model.NgayNhan).Days) đêm / @Model.SoKhach khách</dd><dt class="col-5">Tổng tiền</dt><dd class="col-7 fw-bold">@Model.TongTien.ToString("N0") ₫</dd><dt class="col-5">Thanh toán</dt><dd class="col-7">@(Model.PhuongThucThanhToan=="TaiKhachSan"?"Tại khách sạn":"Chuyển khoản")</dd><dt class="col-5">Ngày đặt</dt><dd class="col-7">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</dd><dt class="col-5">Ghi chú</dt><dd class="col-7 preserve-lines">@Model.GhiChu</dd></dl><a asp-controller="Booking" asp-action="Index" class="btn btn-outline-primary">Đặt phòng của tôi</a></div>
