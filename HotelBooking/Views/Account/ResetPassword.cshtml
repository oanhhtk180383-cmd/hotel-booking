@model ResetModel
@{ViewData["Title"]="Đặt lại mật khẩu";}
<section class="auth-card surface"><span class="eyebrow">HOTELBOOKING</span><h1 class="h2 my-3">Đặt lại mật khẩu</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Token" type="hidden"/><span asp-validation-for="Token" class="text-danger d-block"></span><div class="mb-3"><label asp-for="MatKhauMoi" class="form-label">Mật khẩu mới</label><input asp-for="MatKhauMoi" class="form-control" type="password" /><span asp-validation-for="MatKhauMoi" class="text-danger"></span></div><div class="mb-3"><label asp-for="XacNhan" class="form-label">Xác nhận mật khẩu</label><input asp-for="XacNhan" class="form-control" type="password" /><span asp-validation-for="XacNhan" class="text-danger"></span></div><button class="btn btn-primary w-100">Lưu mật khẩu</button></form><a class="d-block mt-3" asp-action="ForgotPassword">Xác minh lại</a></section>

