@model RegisterModel
@{ViewData["Title"]="Đăng ký tài khoản";}
<section class="auth-card surface"><span class="eyebrow">HOTELBOOKING</span><h1 class="h2 my-3">Đăng ký tài khoản</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="HoTen" class="form-label">Họ tên</label><input asp-for="HoTen" class="form-control" /><span asp-validation-for="HoTen" class="text-danger"></span></div><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" type="email" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="SoDienThoai" class="form-label">Số điện thoại</label><input asp-for="SoDienThoai" class="form-control" type="tel" /><span asp-validation-for="SoDienThoai" class="text-danger"></span></div><div class="mb-3"><label asp-for="MatKhauMoi" class="form-label">Mật khẩu</label><input asp-for="MatKhauMoi" class="form-control" type="password" /><span asp-validation-for="MatKhauMoi" class="text-danger"></span></div><div class="mb-3"><label asp-for="XacNhan" class="form-label">Xác nhận mật khẩu</label><input asp-for="XacNhan" class="form-control" type="password" /><span asp-validation-for="XacNhan" class="text-danger"></span></div><button class="btn btn-primary w-100">Đăng ký</button></form><a class="d-block mt-3" asp-action="Login">Đã có tài khoản? Đăng nhập</a></section>

