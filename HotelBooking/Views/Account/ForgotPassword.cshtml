@model ForgotModel
@{ViewData["Title"]="Quên mật khẩu";}
<section class="auth-card surface"><span class="eyebrow">HOTELBOOKING</span><h1 class="h2 my-3">Quên mật khẩu</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><p class="text-muted">Xác minh bằng email và số điện thoại đã đăng ký.</p><div class="mb-3"><label asp-for="Email" class="form-label">Email</label><input asp-for="Email" class="form-control" type="email" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-3"><label asp-for="SoDienThoai" class="form-label">Số điện thoại</label><input asp-for="SoDienThoai" class="form-control" type="tel" /><span asp-validation-for="SoDienThoai" class="text-danger"></span></div><button class="btn btn-primary w-100">Xác minh</button></form><a class="d-block mt-3" asp-action="Login">Quay lại đăng nhập</a></section>

