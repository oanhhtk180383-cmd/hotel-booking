@model PagedList<NguoiDung>
@{ViewData["Title"]="Quản lý người dùng";}
<h1>Người dùng</h1><form method="get" class="d-flex gap-2 my-4"><input name="email" value="@ViewBag.Email" class="form-control" placeholder="Tìm theo email" aria-label="Tìm theo email"/><button class="btn btn-primary text-nowrap">Tìm kiếm</button></form><div class="surface table-responsive"><table class="table align-middle"><thead><tr><th>Họ tên</th><th>Email</th><th>Số điện thoại</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.HoTen</td><td>@u.Email</td><td>@u.SoDienThoai</td><td>@(u.VaiTro=="Admin"?"Quản trị viên":"Khách hàng")</td><td>@(u.HoatDong?"Hoạt động":"Đã khóa")</td><td>@if(u.MaNguoiDung.ToString()!=User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value){<form method="post" asp-route="admin" asp-route-controller="NguoiDung" asp-route-action="Toggle" asp-route-id="@u.MaNguoiDung"><button class="btn btn-outline-primary btn-sm">@(u.HoatDong?"Khóa":"Mở khóa")</button></form>}</td></tr>}</tbody></table>@if(Model.Count==0){<p class="text-muted">Không có người dùng phù hợp.</p>}</div>

<partial name="_Pagination" model="Model"/>
