@model Phong
@{var title=Model.MaPhong==0?"Thêm phòng":"Sửa phòng";ViewData["Title"]=title;}
<h1>@title</h1><section class="surface editor"><form method="post" asp-route="admin" asp-route-controller="Phong" asp-route-action="@(Model.MaPhong==0?"Create":"Edit")" asp-route-id="@(Model.MaPhong == 0 ? null : Model.MaPhong)"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="SoPhong" class="form-label">Số phòng</label><input asp-for="SoPhong" class="form-control" /><span asp-validation-for="SoPhong" class="text-danger"></span></div><label asp-for="MaLoaiPhong" class="form-label">Loại phòng</label><select asp-for="MaLoaiPhong" asp-items="ViewBag.Types" class="form-select mb-3"><option value="">Chọn loại phòng</option></select><span asp-validation-for="MaLoaiPhong" class="text-danger d-block mb-3"></span><label asp-for="TrangThai" class="form-label">Trạng thái</label><select asp-for="TrangThai" class="form-select mb-4"><option value="SanSang">Sẵn sàng</option><option value="BaoTri">Bảo trì</option></select><span asp-validation-for="TrangThai" class="text-danger d-block mb-3"></span><div class="d-flex gap-2"><button class="btn btn-primary">Lưu phòng</button><a class="btn btn-outline-primary" asp-route="admin" asp-route-controller="Phong" asp-route-action="Index">Quay lại</a></div></form></section>

