@model DashboardModel
@{ViewData["Title"]="Tổng quan quản trị";}
<span class="eyebrow">THỐNG KÊ</span><h1>Tổng quan đặt phòng</h1><div class="row g-3 my-3">@foreach(var s in new[]{"ChoXacNhan","DaXacNhan","HoanThanh","DaHuy"}){<div class="col-sm-6 col-xl-3"><div class="surface"><span class="text-muted">@Labels.Status(s)</span><p class="display-5 mb-0 mt-2">@Model.SoLuong.GetValueOrDefault(s)</p></div></div>}</div><section class="surface mt-4"><h2 class="h4">Doanh thu theo tháng</h2><p class="text-muted">Tổng tiền đặt phòng hoàn thành, theo tháng của ngày trả phòng.</p><div class="table-responsive"><table class="table"><thead><tr><th>Tháng</th><th>Doanh thu</th></tr></thead><tbody>@foreach(var r in Model.DoanhThu){<tr><td>@r.Thang.ToString("D2")/@r.Nam</td><td>@r.TongTien.ToString("N0") ₫</td></tr>}</tbody></table></div>@if(Model.DoanhThu.Count==0){<p class="text-muted">Chưa có doanh thu từ đặt phòng hoàn thành.</p>}</section>
