@model PagedList<DatPhong>
@{ViewData["Title"]="Quản lý đặt phòng";}
<h1>Đặt phòng</h1><form method="get" class="d-flex gap-2 my-4"><select name="trangThai" class="form-select w-auto"><option value="">Tất cả trạng thái</option>@foreach(var s in new[]{"ChoXacNhan","DaXacNhan","HoanThanh","DaHuy"}){<option value="@s" selected="@(ViewBag.Status==s)">@Labels.Status(s)</option>}</select><button class="btn btn-primary">Lọc</button></form>
@foreach(var d in Model){<article class="surface my-3"><div class="d-flex justify-content-between flex-wrap gap-2"><h2 class="h5">#@d.MaDatPhong · @d.NguoiDung.HoTen · Phòng @d.Phong.SoPhong</h2><span class="status @d.TrangThai">@Labels.Status(d.TrangThai)</span></div><p class="text-muted">@d.NguoiDung.Email · @d.NguoiDung.SoDienThoai</p><p>@d.Phong.LoaiPhong!.TenLoaiPhong · @d.NgayNhan.ToString("dd/MM/yyyy") → @d.NgayTra.ToString("dd/MM/yyyy") · @d.SoKhach khách</p><p><strong>@d.TongTien.ToString("N0") ₫</strong> · @(d.PhuongThucThanhToan=="TaiKhachSan"?"Tại khách sạn":"Chuyển khoản")</p><p class="preserve-lines">@d.GhiChu</p><div class="d-flex gap-2">@if(d.TrangThai=="ChoXacNhan"){<form method="post" asp-route="admin" asp-route-controller="DatPhong" asp-route-action="XacNhan" asp-route-id="@d.MaDatPhong"><button class="btn btn-primary btn-sm">Xác nhận</button></form>}@if(d.TrangThai=="DaXacNhan" && HotelClock.Today>=d.NgayNhan){<form method="post" asp-route="admin" asp-route-controller="DatPhong" asp-route-action="HoanThanh" asp-route-id="@d.MaDatPhong"><button class="btn btn-primary btn-sm">Hoàn thành</button></form>}@if(d.TrangThai=="ChoXacNhan" || d.TrangThai=="DaXacNhan"){<form method="post" asp-route="admin" asp-route-controller="DatPhong" asp-route-action="Huy" asp-route-id="@d.MaDatPhong" data-confirm="Hủy đặt phòng này?"><button class="btn btn-outline-danger btn-sm">Hủy</button></form>}</div></article>}
@if(Model.Count==0){<div class="empty-state">Không có đặt phòng phù hợp.</div>}

<partial name="_Pagination" model="Model"/>
