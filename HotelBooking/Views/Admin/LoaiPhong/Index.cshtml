@model PagedList<LoaiPhong>
@{ViewData["Title"]="Quản lý loại phòng";}
<div class="section-title mt-0"><h1>Loại phòng</h1><a class="btn btn-primary" asp-route="admin" asp-route-controller="LoaiPhong" asp-route-action="Create">Thêm loại phòng</a></div><div class="surface table-responsive"><table class="table align-middle"><thead><tr><th>Tên loại phòng</th><th>Giá / đêm</th><th>Số khách tối đa</th><th>Tiện nghi</th><th>Thao tác</th></tr></thead><tbody>@foreach(var m in Model){<tr><td>@m.TenLoaiPhong</td><td>@m.GiaMoiDem.ToString("N0") ₫</td><td>@m.SoKhachToiDa</td><td>@m.TienNghi</td><td><div class="d-flex gap-2"><a class="btn btn-outline-primary btn-sm" asp-route="admin" asp-route-controller="LoaiPhong" asp-route-action="Edit" asp-route-id="@m.MaLoaiPhong">Sửa</a><form method="post" asp-route="admin" asp-route-controller="LoaiPhong" asp-route-action="Xoa" asp-route-id="@m.MaLoaiPhong" data-confirm="Xóa mềm loại phòng và các phòng thuộc loại này?"><button class="btn btn-outline-danger btn-sm">Xóa</button></form></div></td></tr>}</tbody></table>@if(Model.Count==0){<p class="text-muted">Chưa có loại phòng.</p>}</div>

<partial name="_Pagination" model="Model"/>
