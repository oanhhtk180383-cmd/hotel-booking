@model LoaiPhong
@{var title=Model.MaLoaiPhong==0?"Thêm loại phòng":"Sửa loại phòng";ViewData["Title"]=title;}
<h1>@title</h1><section class="surface editor"><form method="post" asp-route="admin" asp-route-controller="LoaiPhong" asp-route-action="@(Model.MaLoaiPhong==0?"Create":"Edit")" asp-route-id="@(Model.MaLoaiPhong == 0 ? null : Model.MaLoaiPhong)"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="TenLoaiPhong" class="form-label">Tên loại phòng</label><input asp-for="TenLoaiPhong" class="form-control" /><span asp-validation-for="TenLoaiPhong" class="text-danger"></span></div><label asp-for="MoTa" class="form-label">Mô tả</label><textarea asp-for="MoTa" class="form-control mb-3" rows="4"></textarea><div class="mb-3"><label asp-for="GiaMoiDem" class="form-label">Giá mỗi đêm (₫)</label><input asp-for="GiaMoiDem" class="form-control" type="number" step="0.01" min="0.01" /><span asp-validation-for="GiaMoiDem" class="text-danger"></span></div><div class="mb-3"><label asp-for="SoKhachToiDa" class="form-label">Số khách tối đa</label><input asp-for="SoKhachToiDa" class="form-control" type="number" min="1" /><span asp-validation-for="SoKhachToiDa" class="text-danger"></span></div><div class="mb-3"><label asp-for="TienNghi" class="form-label">Tiện nghi</label><input asp-for="TienNghi" class="form-control" /><span asp-validation-for="TienNghi" class="text-danger"></span></div><div class="mb-3"><label asp-for="HinhAnh" class="form-label">Đường dẫn ảnh</label><input asp-for="HinhAnh" class="form-control" /><span asp-validation-for="HinhAnh" class="text-danger"></span></div><div class="d-flex gap-2"><button class="btn btn-primary">Lưu loại phòng</button><a class="btn btn-outline-primary" asp-route="admin" asp-route-controller="LoaiPhong" asp-route-action="Index">Quay lại</a></div></form></section>

